# Copy your key here and rename the file to .env, or set the variable
# directly in your shell before starting the server.

# Best free option: Google Gemini (free tier)
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional override (default gemini-2.5-flash)
# DATA_SENTINEL_LLM_MODEL=gemini-2.5-flash

# Paid alternative (uncomment to use instead):
# ANTHROPIC_API_KEY=your_key_here
